ECHOSCENE_TRANSCRIPT_CACHE_TTL_SECONDS=2592000
ECHOSCENE_TRANSCRIPT_MAX_RETRIES=2
ECHOSCENE_TRANSCRIPT_RETRY_BASE_SECONDS=0.35
ECHOSCENE_CONTENT_CACHE_TTL_SECONDS=2592000
ECHOSCENE_PREPARATION_CACHE_MAX_ENTRIES=100
ECHOSCENE_STT_PROVIDER=livekit-inference
ECHOSCENE_STT_MODEL=deepgram/nova-3:multi
ECHOSCENE_LLM_PROVIDER=livekit-inference
