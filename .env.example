ECHOSCENE_ENV=development
ECHOSCENE_API_HOST=127.0.0.1
ECHOSCENE_API_PORT=8787
ECHOSCENE_TRACE_ENABLED=true
ECHOSCENE_TRACE_RETENTION_DAYS=90
ECHOSCENE_TRANSCRIPT_PROVIDER=auto
ECHOSCENE_CONTENT_PROVIDER=deepseek-semantic
