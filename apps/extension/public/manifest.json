{
  "manifest_version": 3,
  "name": "EchoScene",
  "version": "0.15.0",
  "minimum_chrome_version": "116",
  "description": "Turn YouTube AI videos into grounded real-time speaking practice.",
  "permissions": ["sidePanel", "storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "action": {
    "default_title": "Open EchoScene"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ]
}
